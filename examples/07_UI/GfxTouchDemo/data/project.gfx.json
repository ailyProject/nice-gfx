{
  "version": 1,
  "name": "GfxTouchDemo",
  "width": 240,
  "height": 240,
  "initialRoute": "/home",
  "hardware": {"preset":"xiao-round", "board":"esp32:esp32:XIAO_ESP32S3", "display":"GC9A01_240x240_SPI", "edgeBack":true},
  "pages": [
    {
      "id":"home", "name":"首页", "path":"/home",
      "html":"<main id=\"home\"><p id=\"title\">NICE GFX</p><input id=\"brightness\" type=\"range\" min=\"0\" max=\"100\" value=\"60\" data-on-input=\"brightnessChanged\"><gfx-pager id=\"cards\"><section id=\"card-one\"><p id=\"card-one-title\">第一页</p></section><section id=\"card-two\"><p id=\"card-two-title\">第二页</p></section></gfx-pager><button id=\"settings-button\" data-route=\"/settings\">设置</button></main>",
      "css":"main { width:100%; height:100%; padding:16px; gap:8px; background:#172033; color:#ffffff; } #title {height:24px;} #brightness {height:32px;touch-action:pan-y;} #cards {height:72px;overscroll-behavior:contain;} #cards section {padding:8px;background:#254252;} button {height:40px;background:#2563eb;}"
    },
    {
      "id":"settings", "name":"设置", "path":"/settings",
      "html":"<main id=\"settings\"><p id=\"settings-title\">设备设置</p><label id=\"enable-label\" for=\"enabled\">启用通知</label><input id=\"enabled\" type=\"checkbox\" checked data-on-change=\"notificationsChanged\"><button id=\"back\" data-action=\"back\">返回</button></main>",
      "css":"main {width:100%;height:100%;padding:24px;gap:12px;background:#172033;color:#ffffff;}"
    }
  ]
}
