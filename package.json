{
  "name": "nice-gfx-maintenance",
  "private": true,
  "type": "module",
  "scripts": {
    "seeed:generate": "node tools/generate-seeed-epaper.mjs",
    "seeed:check": "node tools/sync-seeed-epaper.mjs --check && node tools/generate-seeed-epaper.mjs --check",
    "test:seeed": "node tests/test-seeed-epaper.mjs",
    "check": "node tools/check-library.mjs",
    "test": "node tests/run.mjs",
    "test:arduino": "node tests/compile-arduino.mjs",
    "test:arduino:u8g2": "node tests/compile-arduino.mjs --sketch=tests/hardware/U8g2Smoke",
    "u8g2:fetch": "node tools/sync-u8g2.mjs --fetch",
    "u8g2:generate": "node tools/generate-u8g2.mjs --generate",
    "u8g2:check": "node tools/sync-u8g2.mjs --check && node tools/generate-u8g2.mjs --check",
    "epaper:fetch": "node tools/sync-gxepd2.mjs --fetch",
    "epaper:generate": "node tools/generate-gxepd2.mjs && node tools/check-epaper-coverage.mjs",
    "epaper:check": "node tools/sync-gxepd2.mjs --check && node tools/generate-gxepd2.mjs --check && node tools/check-epaper-coverage.mjs --check",
    "test:epaper:extra": "node tests/test-epaper-extra.mjs",
    "test:arduino:epaper": "node tests/compile-arduino.mjs --sketch=tests/hardware/EpaperCoverageSmoke",
    "examples:check": "node tools/sync-example-hardware.mjs --check",
    "examples:sync": "node tools/sync-example-hardware.mjs",
    "metadata:sync": "node tools/sync-metadata.mjs"
  },
  "engines": { "node": ">=20.11" }
}
